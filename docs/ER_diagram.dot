digraph ER {
  graph [rankdir=LR, splines=true, nodesep=0.35, ranksep=1.1, fontname="Helvetica", labelloc=t, fontsize=22, label="BatteryPassport - ER diagram (MySQL, crow's-foot notation) + MongoDB telemetry"];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [color="#475569", arrowsize=0.9];
  manufacturer [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#14231c" ALIGN="CENTER"><FONT COLOR="white"><B>manufacturer</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbeafe" PORT="manufacturer_id"><B>manufacturer_id</B><FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#0a5937"> PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbeafe" PORT="name">name<FONT POINT-SIZE="9" COLOR="#555555"> VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbeafe" PORT="country">country<FONT POINT-SIZE="9" COLOR="#555555"> VARCHAR(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbeafe" PORT="contact_email">contact_email<FONT POINT-SIZE="9" COLOR="#555555"> VARCHAR(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbeafe" PORT="created_at">created_at<FONT POINT-SIZE="9" COLOR="#555555"> TIMESTAMP</FONT></TD></TR></TABLE>>];
  battery_model [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#14231c" ALIGN="CENTER"><FONT COLOR="white"><B>battery_model</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbeafe" PORT="model_id"><B>model_id</B><FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#0a5937"> PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbeafe" PORT="manufacturer_id">manufacturer_id<FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#b45309"> FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbeafe" PORT="model_name">model_name<FONT POINT-SIZE="9" COLOR="#555555"> VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbeafe" PORT="chemistry">chemistry<FONT POINT-SIZE="9" COLOR="#555555"> ENUM('LFP','NMC','NCA','LTO','LMO')</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbeafe" PORT="nominal_capacity_kwh">nominal_capacity_kwh<FONT POINT-SIZE="9" COLOR="#555555"> DECIMAL(7,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbeafe" PORT="nominal_voltage_v">nominal_voltage_v<FONT POINT-SIZE="9" COLOR="#555555"> DECIMAL(6,1)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbeafe" PORT="weight_kg">weight_kg<FONT POINT-SIZE="9" COLOR="#555555"> DECIMAL(7,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbeafe" PORT="rated_cycle_life">rated_cycle_life<FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT></TD></TR></TABLE>>];
  stakeholder [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#14231c" ALIGN="CENTER"><FONT COLOR="white"><B>stakeholder</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbeafe" PORT="stakeholder_id"><B>stakeholder_id</B><FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#0a5937"> PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbeafe" PORT="name">name<FONT POINT-SIZE="9" COLOR="#555555"> VARCHAR(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbeafe" PORT="type">type<FONT POINT-SIZE="9" COLOR="#555555"> ENUM('MANUFACTURER','OWNER','FLEET_OPERATOR','SERVICE_CENTER','REFURBISHER','RECYCLER','STORAGE_OPERATOR')</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbeafe" PORT="email">email<FONT POINT-SIZE="9" COLOR="#555555"> VARCHAR(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbeafe" PORT="phone">phone<FONT POINT-SIZE="9" COLOR="#555555"> VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbeafe" PORT="address">address<FONT POINT-SIZE="9" COLOR="#555555"> VARCHAR(200)</FONT></TD></TR></TABLE>>];
  vehicle [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#14231c" ALIGN="CENTER"><FONT COLOR="white"><B>vehicle</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbeafe" PORT="vehicle_id"><B>vehicle_id</B><FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#0a5937"> PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbeafe" PORT="vin">vin<FONT POINT-SIZE="9" COLOR="#555555"> CHAR(17)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbeafe" PORT="make">make<FONT POINT-SIZE="9" COLOR="#555555"> VARCHAR(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbeafe" PORT="model">model<FONT POINT-SIZE="9" COLOR="#555555"> VARCHAR(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbeafe" PORT="model_year">model_year<FONT POINT-SIZE="9" COLOR="#555555"> SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbeafe" PORT="registration_no">registration_no<FONT POINT-SIZE="9" COLOR="#555555"> VARCHAR(20)</FONT></TD></TR></TABLE>>];
  material [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#14231c" ALIGN="CENTER"><FONT COLOR="white"><B>material</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbeafe" PORT="material_id"><B>material_id</B><FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#0a5937"> PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbeafe" PORT="name">name<FONT POINT-SIZE="9" COLOR="#555555"> VARCHAR(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbeafe" PORT="symbol">symbol<FONT POINT-SIZE="9" COLOR="#555555"> VARCHAR(5)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbeafe" PORT="is_critical">is_critical<FONT POINT-SIZE="9" COLOR="#555555"> TINYINT(1)</FONT></TD></TR></TABLE>>];
  model_material [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#14231c" ALIGN="CENTER"><FONT COLOR="white"><B>model_material</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbeafe" PORT="model_id"><B>model_id</B><FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#b45309"> FK</FONT><FONT COLOR="#0a5937"> PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbeafe" PORT="material_id"><B>material_id</B><FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#b45309"> FK</FONT><FONT COLOR="#0a5937"> PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbeafe" PORT="content_kg">content_kg<FONT POINT-SIZE="9" COLOR="#555555"> DECIMAL(8,3)</FONT></TD></TR></TABLE>>];
  app_user [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#14231c" ALIGN="CENTER"><FONT COLOR="white"><B>app_user</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fde0e0" PORT="user_id"><B>user_id</B><FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#0a5937"> PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fde0e0" PORT="username">username<FONT POINT-SIZE="9" COLOR="#555555"> VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fde0e0" PORT="email">email<FONT POINT-SIZE="9" COLOR="#555555"> VARCHAR(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fde0e0" PORT="password_hash">password_hash<FONT POINT-SIZE="9" COLOR="#555555"> VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fde0e0" PORT="role">role<FONT POINT-SIZE="9" COLOR="#555555"> ENUM('ADMIN','OPERATOR','ASSESSOR','RECYCLER')</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fde0e0" PORT="stakeholder_id">stakeholder_id<FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#b45309"> FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fde0e0" PORT="is_active">is_active<FONT POINT-SIZE="9" COLOR="#555555"> TINYINT(1)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fde0e0" PORT="created_at">created_at<FONT POINT-SIZE="9" COLOR="#555555"> TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fde0e0" PORT="last_login">last_login<FONT POINT-SIZE="9" COLOR="#555555"> DATETIME</FONT></TD></TR></TABLE>>];
  battery [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#14231c" ALIGN="CENTER"><FONT COLOR="white"><B>battery</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#d9f2e4" PORT="battery_id"><B>battery_id</B><FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#0a5937"> PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#d9f2e4" PORT="serial_number">serial_number<FONT POINT-SIZE="9" COLOR="#555555"> VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#d9f2e4" PORT="model_id">model_id<FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#b45309"> FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#d9f2e4" PORT="manufacture_date">manufacture_date<FONT POINT-SIZE="9" COLOR="#555555"> DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#d9f2e4" PORT="status">status<FONT POINT-SIZE="9" COLOR="#555555"> ENUM('MANUFACTURED','IN_SERVICE','REMOVED','REFURBISHED','SECOND_LIFE','RECYCLED')</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#d9f2e4" PORT="current_soh_pct">current_soh_pct<FONT POINT-SIZE="9" COLOR="#555555"> DECIMAL(5,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#d9f2e4" PORT="total_cycles">total_cycles<FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#d9f2e4" PORT="registered_by">registered_by<FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#b45309"> FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#d9f2e4" PORT="created_at">created_at<FONT POINT-SIZE="9" COLOR="#555555"> TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#d9f2e4" PORT="updated_at">updated_at<FONT POINT-SIZE="9" COLOR="#555555"> TIMESTAMP</FONT></TD></TR></TABLE>>];
  battery_certification [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#14231c" ALIGN="CENTER"><FONT COLOR="white"><B>battery_certification</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#d9f2e4" PORT="cert_id"><B>cert_id</B><FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#0a5937"> PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#d9f2e4" PORT="battery_id">battery_id<FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#b45309"> FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#d9f2e4" PORT="cert_name">cert_name<FONT POINT-SIZE="9" COLOR="#555555"> VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#d9f2e4" PORT="issuing_body">issuing_body<FONT POINT-SIZE="9" COLOR="#555555"> VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#d9f2e4" PORT="certificate_no">certificate_no<FONT POINT-SIZE="9" COLOR="#555555"> VARCHAR(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#d9f2e4" PORT="issued_on">issued_on<FONT POINT-SIZE="9" COLOR="#555555"> DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#d9f2e4" PORT="expires_on">expires_on<FONT POINT-SIZE="9" COLOR="#555555"> DATE</FONT></TD></TR></TABLE>>];
  installation [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#14231c" ALIGN="CENTER"><FONT COLOR="white"><B>installation</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="installation_id"><B>installation_id</B><FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#0a5937"> PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="battery_id">battery_id<FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#b45309"> FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="vehicle_id">vehicle_id<FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#b45309"> FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="installed_on">installed_on<FONT POINT-SIZE="9" COLOR="#555555"> DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="removed_on">removed_on<FONT POINT-SIZE="9" COLOR="#555555"> DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="odometer_at_install_km">odometer_at_install_km<FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="odometer_at_removal_km">odometer_at_removal_km<FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="removal_reason">removal_reason<FONT POINT-SIZE="9" COLOR="#555555"> VARCHAR(200)</FONT></TD></TR></TABLE>>];
  ownership_record [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#14231c" ALIGN="CENTER"><FONT COLOR="white"><B>ownership_record</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="ownership_id"><B>ownership_id</B><FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#0a5937"> PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="battery_id">battery_id<FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#b45309"> FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="stakeholder_id">stakeholder_id<FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#b45309"> FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="from_date">from_date<FONT POINT-SIZE="9" COLOR="#555555"> DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="to_date">to_date<FONT POINT-SIZE="9" COLOR="#555555"> DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="transfer_reason">transfer_reason<FONT POINT-SIZE="9" COLOR="#555555"> VARCHAR(200)</FONT></TD></TR></TABLE>>];
  repair_record [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#14231c" ALIGN="CENTER"><FONT COLOR="white"><B>repair_record</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="repair_id"><B>repair_id</B><FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#0a5937"> PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="battery_id">battery_id<FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#b45309"> FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="service_stakeholder_id">service_stakeholder_id<FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#b45309"> FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="repair_date">repair_date<FONT POINT-SIZE="9" COLOR="#555555"> DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="repair_type">repair_type<FONT POINT-SIZE="9" COLOR="#555555"> ENUM('CELL_REPLACEMENT','MODULE_REPLACEMENT','BMS_UPDATE','COOLING_SYSTEM','CONNECTOR_REPAIR','OTHER')</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="description">description<FONT POINT-SIZE="9" COLOR="#555555"> TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="cost">cost<FONT POINT-SIZE="9" COLOR="#555555"> DECIMAL(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="cells_replaced">cells_replaced<FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT></TD></TR></TABLE>>];
  health_record [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#14231c" ALIGN="CENTER"><FONT COLOR="white"><B>health_record</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="health_id"><B>health_id</B><FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#0a5937"> PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="battery_id">battery_id<FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#b45309"> FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="recorded_at">recorded_at<FONT POINT-SIZE="9" COLOR="#555555"> DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="soh_pct">soh_pct<FONT POINT-SIZE="9" COLOR="#555555"> DECIMAL(5,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="cycle_count">cycle_count<FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="avg_temp_c">avg_temp_c<FONT POINT-SIZE="9" COLOR="#555555"> DECIMAL(5,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="max_temp_c">max_temp_c<FONT POINT-SIZE="9" COLOR="#555555"> DECIMAL(5,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="source">source<FONT POINT-SIZE="9" COLOR="#555555"> ENUM('TELEMETRY_SUMMARY','LAB_TEST','SERVICE_CHECK')</FONT></TD></TR></TABLE>>];
  telemetry_threshold [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#14231c" ALIGN="CENTER"><FONT COLOR="white"><B>telemetry_threshold</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e5e7eb" PORT="metric"><B>metric</B><FONT POINT-SIZE="9" COLOR="#555555"> ENUM('temperature_c','voltage_v','current_a','soc_pct','soh_pct')</FONT><FONT COLOR="#0a5937"> PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e5e7eb" PORT="min_value">min_value<FONT POINT-SIZE="9" COLOR="#555555"> DECIMAL(8,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e5e7eb" PORT="max_value">max_value<FONT POINT-SIZE="9" COLOR="#555555"> DECIMAL(8,2)</FONT></TD></TR></TABLE>>];
  battery_alert [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#14231c" ALIGN="CENTER"><FONT COLOR="white"><B>battery_alert</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e5e7eb" PORT="alert_id"><B>alert_id</B><FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#0a5937"> PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e5e7eb" PORT="battery_id">battery_id<FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#b45309"> FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e5e7eb" PORT="metric">metric<FONT POINT-SIZE="9" COLOR="#555555"> ENUM('temperature_c','voltage_v','current_a','soc_pct','soh_pct')</FONT><FONT COLOR="#b45309"> FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e5e7eb" PORT="observed_value">observed_value<FONT POINT-SIZE="9" COLOR="#555555"> DECIMAL(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e5e7eb" PORT="limit_value">limit_value<FONT POINT-SIZE="9" COLOR="#555555"> DECIMAL(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e5e7eb" PORT="direction">direction<FONT POINT-SIZE="9" COLOR="#555555"> ENUM('ABOVE_MAX','BELOW_MIN')</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e5e7eb" PORT="recorded_at">recorded_at<FONT POINT-SIZE="9" COLOR="#555555"> DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e5e7eb" PORT="status">status<FONT POINT-SIZE="9" COLOR="#555555"> ENUM('OPEN','ACKNOWLEDGED')</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e5e7eb" PORT="acknowledged_by">acknowledged_by<FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#b45309"> FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e5e7eb" PORT="created_at">created_at<FONT POINT-SIZE="9" COLOR="#555555"> TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e5e7eb" PORT="note">note<FONT POINT-SIZE="9" COLOR="#555555"> VARCHAR(200)</FONT></TD></TR></TABLE>>];
  assessment_rule [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#14231c" ALIGN="CENTER"><FONT COLOR="white"><B>assessment_rule</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e5e7eb" PORT="rule_key"><B>rule_key</B><FONT POINT-SIZE="9" COLOR="#555555"> VARCHAR(50)</FONT><FONT COLOR="#0a5937"> PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e5e7eb" PORT="rule_value">rule_value<FONT POINT-SIZE="9" COLOR="#555555"> DECIMAL(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e5e7eb" PORT="description">description<FONT POINT-SIZE="9" COLOR="#555555"> VARCHAR(200)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e5e7eb" PORT="updated_at">updated_at<FONT POINT-SIZE="9" COLOR="#555555"> TIMESTAMP</FONT></TD></TR></TABLE>>];
  second_life_assessment [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#14231c" ALIGN="CENTER"><FONT COLOR="white"><B>second_life_assessment</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="assessment_id"><B>assessment_id</B><FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#0a5937"> PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="battery_id">battery_id<FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#b45309"> FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="assessed_by">assessed_by<FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#b45309"> FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="assessed_on">assessed_on<FONT POINT-SIZE="9" COLOR="#555555"> DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="soh_pct">soh_pct<FONT POINT-SIZE="9" COLOR="#555555"> DECIMAL(5,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="cycle_count">cycle_count<FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="max_temp_c">max_temp_c<FONT POINT-SIZE="9" COLOR="#555555"> DECIMAL(5,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="repair_count">repair_count<FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="score">score<FONT POINT-SIZE="9" COLOR="#555555"> DECIMAL(5,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="decision">decision<FONT POINT-SIZE="9" COLOR="#555555"> ENUM('SECOND_LIFE_ELIGIBLE','REFURBISH_FIRST','RECYCLE')</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="explanation">explanation<FONT POINT-SIZE="9" COLOR="#555555"> TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="rules_used">rules_used<FONT POINT-SIZE="9" COLOR="#555555"> JSON</FONT></TD></TR></TABLE>>];
  refurbishment_record [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#14231c" ALIGN="CENTER"><FONT COLOR="white"><B>refurbishment_record</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="refurb_id"><B>refurb_id</B><FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#0a5937"> PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="battery_id">battery_id<FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#b45309"> FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="refurbisher_id">refurbisher_id<FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#b45309"> FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="start_date">start_date<FONT POINT-SIZE="9" COLOR="#555555"> DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="end_date">end_date<FONT POINT-SIZE="9" COLOR="#555555"> DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="work_done">work_done<FONT POINT-SIZE="9" COLOR="#555555"> TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="soh_before">soh_before<FONT POINT-SIZE="9" COLOR="#555555"> DECIMAL(5,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="soh_after">soh_after<FONT POINT-SIZE="9" COLOR="#555555"> DECIMAL(5,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="outcome">outcome<FONT POINT-SIZE="9" COLOR="#555555"> ENUM('IN_PROGRESS','REUSED_STATIONARY','REUSED_VEHICLE','FAILED')</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="reuse_application">reuse_application<FONT POINT-SIZE="9" COLOR="#555555"> VARCHAR(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="cost">cost<FONT POINT-SIZE="9" COLOR="#555555"> DECIMAL(10,2)</FONT></TD></TR></TABLE>>];
  recycling_record [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#14231c" ALIGN="CENTER"><FONT COLOR="white"><B>recycling_record</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="recycling_id"><B>recycling_id</B><FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#0a5937"> PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="battery_id">battery_id<FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#b45309"> FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="recycler_id">recycler_id<FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#b45309"> FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="recycled_on">recycled_on<FONT POINT-SIZE="9" COLOR="#555555"> DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="method">method<FONT POINT-SIZE="9" COLOR="#555555"> ENUM('HYDROMETALLURGICAL','PYROMETALLURGICAL','DIRECT_RECYCLING')</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="total_input_kg">total_input_kg<FONT POINT-SIZE="9" COLOR="#555555"> DECIMAL(8,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="notes">notes<FONT POINT-SIZE="9" COLOR="#555555"> VARCHAR(300)</FONT></TD></TR></TABLE>>];
  recovered_material [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#14231c" ALIGN="CENTER"><FONT COLOR="white"><B>recovered_material</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="recovery_id"><B>recovery_id</B><FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#0a5937"> PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="recycling_id">recycling_id<FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#b45309"> FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="material_id">material_id<FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#b45309"> FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="quantity_kg">quantity_kg<FONT POINT-SIZE="9" COLOR="#555555"> DECIMAL(10,3)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ece3fb" PORT="purity_pct">purity_pct<FONT POINT-SIZE="9" COLOR="#555555"> DECIMAL(5,2)</FONT></TD></TR></TABLE>>];
  lifecycle_event [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#14231c" ALIGN="CENTER"><FONT COLOR="white"><B>lifecycle_event</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="event_id"><B>event_id</B><FONT POINT-SIZE="9" COLOR="#555555"> BIGINT</FONT><FONT COLOR="#0a5937"> PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="battery_id">battery_id<FONT POINT-SIZE="9" COLOR="#555555"> INT</FONT><FONT COLOR="#b45309"> FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="event_type">event_type<FONT POINT-SIZE="9" COLOR="#555555"> ENUM('MANUFACTURED','INSTALLED','REMOVED','OWNERSHIP_TRANSFER','REPAIR','CERTIFIED','ASSESSED','REFURBISHED','REUSED','RECYCLED')</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="event_time">event_time<FONT POINT-SIZE="9" COLOR="#555555"> DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf0d2" PORT="description">description<FONT POINT-SIZE="9" COLOR="#555555"> VARCHAR(300)</FONT></TD></TR></TABLE>>];
