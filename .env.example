# Copy this file to .env.local and adjust the values.
# Credentials are read from environment variables only - never hard-coded.

# --- MySQL (structured lifecycle records) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=bp_root_pw
MYSQL_DATABASE=batterypassport

# --- MongoDB (battery telemetry) ---
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=batterypassport

# --- Authentication ---
# Any long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
